de_now\\\":\\\"Trade Now\\\",\\\"mc_landings_redemption_task_title_futures\\\":\\\"Futures Trading\\\",\\\"mc_landings_redemption_task_description_futures\\\":\\\"Achieve a futures trading volume of {price} USDT to earn {getPoints} points\\\",\\\"mc_landings_redemption_task_title_daily_check_in\\\":\\\"Daily Check-In\\\",\\\"mc_landings_redemption_task_description_daily_check_in\\\":\\\"Click the check-in button daily to complete the task and earn {getPoints} points (KYC required)\\\",\\\"mc_landings_redemption_daily_check_in_now\\\":\\\"Check In\\\",\\\"mc_landings_redemption_daily_check_in_checked\\\":\\\"Checked In\\\",\\\"mc_landings_redemption_task_title_efttc_contract_trade\\\":\\\"First Deposit + Futures Trading\\\",\\\"mc_landings_redemption_task_description_efttc_contract_trade\\\":\\\"Deposit over {price} USDT within {day} days after first deposit and complete the specified Futures trading volume\\\",\\\"mc_landings_redemption_task_completed\\\":\\\"Completed\\\",\\\"mc_landings_redemption_notice_efttc\\\":\\\"Futures trading volume must be at least {price} USDT\\\",\\\"mc_landings_redemption_task_history_registration\\\":\\\"Registration Completed\\\",\\\"mc_landings_redemption_task_history_invite\\\":\\\"Invitation Completed\\\",\\\"mc_landings_redemption_task_history_verification\\\":\\\"Verification Completed\\\",\\\"mc_landings_redemption_task_history_deposit\\\":\\\"Deposit: {price} USDT\\\",\\\"mc_landings_redemption_task_history_spot\\\":\\\"Spot Trading: {price} USDT\\\",\\\"mc_landings_redemption_task_history_futures\\\":\\\"Futures Trading: {price} USDT\\\",\\\"mc_landings_redemption_task_history_system\\\":\\\"System Distribution\\\",\\\"mc_landings_redemption_event_details\\\":\\\"Event Details\\\",\\\"mc_landings_redemption_share\\\":\\\"Share\\\",\\\"mc_landings_redemption_redemption_history\\\":\\\"Redemption History\\\",\\\"mc_landings_redemption_earning_history\\\":\\\"Earning History\\\",\\\"mc_landings_redemption_register\\\":\\\"Regist