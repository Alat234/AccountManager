telist_add_address_modal_desc1\\\":\\\"Once set as a whitelisted address, no security verification is required for withdrawals of ≤ \\u003cspan\\u003e{num}\\u003c/span\\u003e.\\\",\\\"mc_withdrawal_whitelist_add_contact_modal_desc2\\\":\\\"You have not enabled fast withdrawals. Once enabled, no security verification is required when making small transfers to whitelisted contacts.\\\",\\\"mc_withdrawal_whitelist_batch_add_address_address_type\\\":\\\"Address Type\\\",\\\"mc_withdrawal_whitelist_batch_add_address_confirm_modal_title\\\":\\\"Cancel Saving?\\\",\\\"mc_withdrawal_whitelist_batch_add_address_confirm_modal_content\\\":\\\"The address you filled out has not been saved. Are you sure you want to cancel this edit?\\\",\\\"mc_withdrawal_whitelist_batch_add_address_confirm_modal_button\\\":\\\"Continue Editing\\\",\\\"mc_withdrawal_whitelist_batch_operate\\\":\\\"\\u003cspan\\u003e{num}\\u003c/span\\u003e addresses selected. What's your next step?\\\",\\\"mc_withdraw_contacts_batch_add_cancellation_content\\\":\\\"The contact you added has not been saved. Are you sure you want to cancel this edit?\\\",\\\"mc_withdraw_contacts_batch_add_title\\\":\\\"Bulk Add Contacts\\\",\\\"mc_withdraw_contacts_batch_add_account_type\\\":\\\"Account Type\\\",\\\"mc_withdraw_contacts_batch_add_account_name\\\":\\\"Account Name\\\",\\\"mc_contact_whitelist_remove_confirmation_desc\\\":\\\"Are you sure you want to remove the selected contact from whitelist?\\\",\\\"mc_contact_remove_confirmation_desc\\\":\\\"Are you sure you want to remove the selected contact?\\\",\\\"mc_contact_remove_confirmation_title\\\":\\\"Delete Contact?\\\",\\\"mc_withdrawal_edit_address_label\\\":\\\"Edit Address Label\\\",\\\"mc_withdraw_edit_remark_success\\\":\\\"Address label changed successfully\\\",\\\"mc_contact_whitelist_batch_add_address_confirm_modal_content\\\":\\\"Your added contact has not yet been saved. Are you sure you want to cancel this edit?\\\",\\\"mc_withdrawal_whitelist_batch_add\\\":\\\"Whitelist\\\",\\\"mc_withdraw_address_tag_add\\\":\\\"Address Label (Optional)\\\",\\\"mc_withdraw_memo_add\\\":\\\"Memo/Tag (Optional)\\\",\\\"mc_withdrawal_whitelist_add_form\\\":\\\"Set as a whitelisted address\\\",\\\"mc_withdrawal_send_whitelist_add_form\\\":\\\"Set as Whitelisted Contact\\\",\\\"mc_withdrawal_whitelist_add_send_modal_desc1\\\":\\\"Once set as a whitelisted contact, no security verification is required for withdrawals of ≤ \\u003cspan\\u003e{num}\\u003c/span\\u003e.\\\",\\\"mc_withdrawal_whitelist_add_address_modal_desc2\\\":\\\"You have not enabled fast withdrawals. Once enabled, no security verification is required when making small withdrawals to whitelisted addresses.\\\",\\\"mc_user_id_auth_advanced_photo_requirement_info_1\\\":\\\"1. Please provide a valid government-issued identification document.\\\",\\\"mc_user_id_auth_withdraw_limit_info\\\":\\\"Increase 24-hour withdrawal limit to {withdrawLimit} BTC\\\",\\\"mc_user_id_auth_id_info\\\":\\\"Government-issued ID\\\",\\\"mc_user_id_auth_exit_verification_has_award_title\\\":\\\"Are you sure you want to forfeit the KYC verification task reward?\\\",\\\"mc_user_id_auth_exit_verification_has_award_info_voucher\\\":\\\"Complete the KYC verification task to claim a \\u003cspan1\\u003e{awardAmount}\\u003c/span1\\u003e \\u003cspan2\\u003e{awardCurrency}\\u003c/span2\\u003e voucher and get a chance to win 10,000 USDT bonus.\\\",\\\"mc_withdrawal_contact_single_add_max_prompt\\\":\\\"Bulk add up to 20 contacts at a time\\\",\\\"mc_user_id_auth_additional_verification_info\\\":\\\"In the additional verification process, you need to complete the following two steps:\\\",\\\"mc_user_id_auth_additional_verification_step1_title\\\":\\\"Provide Address Proof\\\",\\\"mc_user_id_auth_additional_verification_step1_info\\\":\\\"Please provide a valid proof of residence (e.g., tax bill, utility bill, bank statement) with a clear and legible document issued within the last 3 months.\\\",\\\"mc_user_id_auth_additional_verification_step2_title\\\":\\\"Complete Due Diligence\\\",\\\"mc_user_id_auth_additional_verification_step2_info\\\":\\\"Please fill out the information questionnaire regarding your occupation, income, source of funds, and investments. Ensure that the information you provide is accurate and up-to-date.\\\",\\\"mc_user_id_auth_address_proof_info_1\\\":\\\"Please provide a proof of your current residential address with an issue date/validity within the last three months.\\\",\\\"mc_user_id_auth_address_proof_file_support\\\":\\\"Only the following documents are accepted:\\\",\\\"mc_user_id_auth_address_proof_file_not_support\\\":\\\"Please note, we do not accept the following documents:\\\",\\\"mc_user_id_auth_address_proof_file_support_file1\\\":\\\"Identity document with address\\\",\\\"mc_user_id_auth_address_proof_file_not_support_file1\\\":\\\"Screenshots\\\",\\\"mc_user_id_auth_address_proof_file_not_support_file2\\\":\\\"Purchase receipts\\\",\\\"mc_user_id_auth_address_proof_file_not_support_file3\\\":\\\"Medical bills\\\",\\\"mc_user_id_auth_address_proof_file_requirement_3\\\":\\\"The issue date/validity of the document must be within three months.\\\",\\\"mc_user_id_auth_additional_verification_not_support_info\\\":\\\"You are currently unable to apply for additional verification with your account. Please contact Customer Service for more information.\\\",\\\"mc_user_security_reset_account_sign_up_date\\\":\\\"Account Sign-up Date\\\",\\\"mc_user_security_reset_last_login_country_region_and_city\\\":\\\"Last Login Country/Region and City\\\",\\\"mc_user_security_reset_recent_trades_placeholder\\\":\\\"Please provide recent trading types and specific crypto names or trading pairs for this account\\\",\\\"mc_user_security_handwrite_following_info\\\":\\\"Please handwrite or print the following content on a blank piece of paper:\\\",\\\"mc_user_user_futures_bonus\\\":\\\"Claim ${amount} Bonus\\\",\\\"mc_user_user_futures_bonus_info\\\":\\\"Come experience futures trading at 0 cost!\\\",\\\"mc_user_user_receive_award_success\\\":\\\"Claim Successful\\\",\\\"mc_user_user_receive_award_content\\\":\\\"You have received a {amount} USDT bonus. Come experience futures trading at 0 cost!\\\",\\\"mc_user_user_receive_award_error\\\":\\\"System error, claim failed. Please try again.\\\",\\\"mc_user_hot_activity_key_task_mx\\\":\\\"Complete KYC verification task to earn a \\u003cspan\\u003e{amount} {currency}\\u003c/span\\u003e voucher\\\",\\\"mc_user_hot_activity_key_task_currency\\\":\\\"Complete KYC verification task to earn \\u003cspan\\u003e{amount} {currency}\\u003c/span\\u003e\\\",\\\"mc_user_id_auth_face_auth_with_colon\\\":\\\"Facial Recognition: \\\",\\\"mc_user_id_auth_address_proof_file_not_support_file4\\\":\\\"Unsupported document types: Screenshots, purchase receipts, medical bills, ID cards, passports, driver’s licenses, and residence permits\\\",\\\"mc_user_id_auth_additional_faq_qustion_2\\\":\\\"Why can't I find my country or region for address verification?\\\",\\\"mc_user_id_auth_additional_faq_answer_2_1\\\":\\\"Address verification is currently available only for the following countries:\\\",\\\"mc_user_id_auth_additional_faq_answer_2_2\\\":\\\"Austria, Belgium, Bulgaria, Croatia, Cyprus, Czech Republic, Denmark, Estonia, Finland, France, Germany, Greece, Hungary, Iceland, Ireland, Italy, Latvia, Liechtenstein, Lithuania, Luxembourg, Malta, Netherlands, Norway, Poland, Portugal, Romania, Slovakia, Slovenia, Spain, Sweden, and Switzerland.\\\",\\\"mc_user_id_auth_additional_faq_answer_3_3\\\":\\\"2. ID with address (front and back)\\\",\\\"mc_user_preference_chat_notifications\\\":\\\"Chat Notifications\\\",\\\"mc_user_id_auth_tr_senior_auth_intro\\\":\\\"Verify your identity to start your MEXC TR cryptocurrency journey!\\\",\\\"mc_user_id_auth_advanced_photo_requirement_info_tr\\\":\\\"Only the following documents issued by the Turkish government are accepted: ✅ ID Card ✅ Residence Permit.\\\",\\\"mc_user_id_auth_place_birth\\\":\\\"Place of Birth\\\",\\\"mc_user_id_auth_place_birth_placeholder\\\":\\\"Please enter your place of birth\\\",\\\"mc_user_id_auth_address_desc_tr\\\":\\\"Upload a residence document obtained within the last 30 days via the e-Government system, or \\u003ca\\u003elog in to the e-Government system\\u003c/a\\u003e to verify, download the file, and upload it again.\\\",\\\"mc_user_id_auth_address_16_barcode_number\\\":\\\"16-Digit Barcode Number\\\",\\\"mc_user_id_auth_address_16_barcode_placeholder\\\":\\\"Please enter the 16-digit number located at the top-right corner of the residence document\\\",\\\"mc_user_security_passkey_delete_confirm\\\":\\\"Delete Passkey\\\",\\\"mc_user_security_passkey_current_device\\\":\\\"This Device\\\",\\\"mc_id_auth_advance_ai_not_support_browser\\\":\\\"Your current browser doesn’t support verification. Please use a different browser.\\\",\\\"mc_id_auth_advance_ai_reselect_doc_type\\\":\\\"Invalid ID format. Please try again.\\\",\\\"mc_id_auth_advance_ai_bad_response\\\":\\\"Submission failed. Please try again.\\\",\\\"mc_user_id_auth_additional_box_option_1_new\\\":\\\"I am submitting a utility bill, bank statement, government letter, or similar document\\\",\\\"mc_user_id_auth_upload_file_components_type_hint\\\":\\\"Upload one copy for documents, or both sides for ID\\\",\\\"mc_user_id_auth_overseas_chinese_only_mainland\\\":\\\"Mainland China ID documents only\\\",\\\"mc_vip_head_title\\\":\\\"MEXC VIP Privileges | MEXC Exchange\\\",\\\"mc_vip_head_keywords\\\":\\\"Exclusive Benefits of MEXC VIPs\\\",\\\"mc_vip_head_description\\\":\\\"VIPs of MEXC have early subscription opportunities to high-quality projects, enjoy 1-to-1 service with our VIP manager, trade with special rates, institutional vault account, and have the opportunity to become regional partners of MEXC Exchange!\\\",\\\"mc_vip_title\\\":\\\"VIP Privileges\\\",\\\"mc_vip_title_new\\\":\\\"MEXC VIP Center\\\",\\\"mc_vip_rights_6\\\":\\\"24/7 VIP Customer Service\\\",\\\"mc_vip_rights_total\\\":\\\"Exclusive Benefits\\\",\\\"mc_vip_desc\\\":\\\"VIP Level and Key Benefits\\\",\\\"mc_vip_card_unlocked\\\":\\\"Current progress\\\",\\\"mc_vip_card_locked\\\":\\\"Locked\\\",\\\"mc_vip_card_unlocked_surpass\\\":\\\"You have surpassed this level\\\",\\\"mc_vip_card_unlocked_expires\\\":\\\"Valid until: {date}\\\",\\\"mc_vip_card_require\\\":\\\"Total assets ≥ {num} to unlock {type}\\\",\\\"mc_vip_rights_1\\\":\\\"Exclusive Trading Fees\\\",\\\"mc_vip_rights_3\\\":\\\"MEXC VIP Icon\\\",\\\"mc_vip_rights_4\\\":\\\"Personal VIP Service Group\\\",\\\"mc_vip_rights_5\\\":\\\"MEXC Industry Analysis Report\\\",\\\"mc_vip_rights_7\\\":\\\"MEXC Investment Counselor\\\",\\\"mc_vip_rights_8\\\":\\\"Exclusive API Service\\\",\\\"mc_vip_rights_9\\\":\\\"Express Deposit \\u0026 Withdrawal Channel\\\",\\\"mc_vip_rights_10\\\":\\\"Withdrawal Limit Increase\\\",\\\"mc_vip_rights_11\\\":\\\"MEXC Affiliate Program\\\",\\\"mc_vip_rights_12\\\":\\\"Prioritized Invitation to MEXC's Offline Events\\\",\\\"mc_vip_rights_13\\\":\\\"Priority in New Product Beta Test\\\",\\\"mc_vip_rights_14\\\":\\\"High-quality Projects Subscription\\\",\\\"mc_vip_rights_15\\\":\\\"MEXC·VIP Private Seminar\\\",\\\"mc_vip_rights_16\\\":\\\"Holiday \\u0026 Birthday Gifting\\\",\\\"mc_vip_card_require_desc\\\":\\\"To become a {type}, you need to increase your total assets by {num}\\\",\\\"mc_vip_card_require_progress\\\":\\\"Current progress {num}\\\",\\\"mc_vip_card_criteria\\\":\\\"VIP Benefits Criteria\\\",\\\"mc_vip_card_type\\\":\\\"VIP Privileges\\\",\\\"mc_vip_card_period\\\":\\\"VIP Level Retention Period (Days)\\\",\\\"mc_vip_card_assets\\\":\\\"Total Assets\\\",\\\"mc_vip_specifics\\\":\\\"VIP Benefits Specifics\\\",\\\"mc_vip_specifics_text_1\\\":\\\"1. A snapshot of your total assets will be taken between 00:00 and 24:00 (UTC+8) on the previous day for calculation.\\\",\\\"mc_vip_specifics_text_2\\\":\\\"2. VIP levels and benefits will be determined and updated every day between 00:00 and 08:00 (UTC+8). Due to the large volume of data processed, there may be a delay in the update of VIP level. Please refer to the actual update time.\\\",\\\"mc_vip_specifics_text_3\\\":\\\"3. Once updated, your VIP level will be maintained throughout the retention period. If you meet the conditions for a VIP level upgrade during this period, your VIP level will be upgraded automatically. During the retention period, all VIP privileges corresponding to the VIP level (excluding VIP trading fees) are guaranteed.\\\",\\\"mc_vip_specifics_text_4\\\":\\\"4. You may also contact your VIP manager to enjoy exclusive VIP trading fees if you fulfill the requirements. However, please take note that this benefit will be withdrawn if the value of your total assets falls below the minimum requirements for 7 days straight.\\\",\\\"mc_vip_contact_text_1\\\":\\\"If your assets on MEXC are \\u003cspan\\u003e≥ 300,000 USDT\\u003c/span\\u003e, you can contact us to apply to become a VIP through the following methods.\\\",\\\"mc_vip_contact_text_2\\\":\\\"Send an email to \\u003ca\\u003e\\u003c/a\\u003e for any inquiries or questions. Your inquiry could include the following information: your name, contact number, Telegram ID, your country (so we can assign a VIP specialist who speaks your language), and any specific needs or suggestions you may have.\\\",\\\"mc_vip_contact_text_3\\\":\\\"2. Add our MEXC VIP manager via Telegram: \\u003ca\\u003e\\u003c/a\\u003e for 1-to-1 service\\\",\\\"mc_vip_contact_text_4\\\":\\\"3. Once you become a VIP, you can access to the 24/7 VIP customer service through your exclusive VIP channel\\\",\\\"mc_vip_contract_email_desc\\\":\\\"Your inquiry could include the following information: your name, contact number, Telegram ID, your country (so we can assign a VIP specialist who speaks your language), and any specific needs or suggestions you may have.\\\",\\\"mc_vip_contract_telegram_desc\\\":\\\"Add the MEXC VIP manager for 1 to 1 service\\\",\\\"mc_vip_card_tip_text_1\\\":\\\"1. If you become a VIP via automatic upgrade, your VIP level will not be downgraded within the valid period. If you meet the upgrade conditions during this period, you will be automatically upgraded to a higher level\\\",\\\"mc_vip_card_tip_text_2\\\":\\\"2. If you become a VIP by applying for trial, your VIP level will remain unchanged within the valid period, and the system will re-approve your level after the valid period expires;\\\",\\\"mc_vip_1_to_1\\\":\\\"1 to 1\\\",\\\"mc_vip_specifics_text_3_change\\\":\\\"3. During the retention period after your latest VIP level takes effect, your VIP level will not be downgraded. If you meet the upgrade conditions during this period, your VIP level will be upgraded automatically. You can enjoy the VIP rights other than the special trading fees during the retention period.\\\",\\\"mc_vip_specifics_text_4_change\\\":\\\"4. For fee rate discount settings, please contact your VIP manager for upgrade and adjustment. If your total assets do not meet the corresponding VIP standard for 7 consecutive days, the fee rate discount will be canceled.\\\",\\\"mc_vip_head_title1\\\":\\\"MEXC VIP User Benefits Program | Become a VIP User\\\",\\\"mc_vip_head_keywords1\\\":\\\"mexc vip, mexc support, mexc vip account\\\",\\\"mc_vip_head_description1\\\":\\\"Find out how to become an MEXC VIP User to enjoy additional benefits such as premium support, special VIP activities and trading discounts on our exchange.\\\",\\\"mc_vip_contact_vip_emails\\\":\\\"\\u003ca href=\\\\\\\"mailto:vip.en@mexc.com\\\\\\\"\\u003evip.en@mexc.com\\u003c/a\\u003e\\\",\\\"mc_vip_contact_vip_telegrams\\\":\\\"\\u003ca target=\\\\\\\"_blank\\\\\\\" rel=\\\\\\\"nofollow noopener noreferrer\\\\\\\" href=\\\\\\\"https://t.me/MEXC_Darry\\\\\\\"\\u003e@MEXC_Darry\\u003c/a\\u003e\\\",\\\"mc_vip_exclusive_vip_events\\\":\\\"Exclusive VIP Events\\\",\\\"mc_vip_to_upgrade_to_next_vip_info\\\":\\\"To upgrade to {type} and unlock more benefits, you need to increase your total asset equivalent by {num}.\\\"},\\\"now\\\":\\\"$undefined\\\",\\\"timeZone\\\":\\\"Asia/Shanghai\\\",\\\"children\\\":\\\"$L4d\\\"}]\\n\"])\u003C/script>\u003Cscript>self.__next_f.push([1,\"4d:[\\\"$\\\",\\\"$L4e\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$L4f\\\",null,{\\\"header\\\":\\\"$L50\\\",\\\"children\\\":[\\\"$\\\",\\\"$L2\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$51\\\",\\\"errorStyles\\\":[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"https://static.mocortech.com/production/mxc-web-ucenter-v4/97/_next/static/chunks/10syvpgi57mwg.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],\\\"errorScripts\\\":[[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"https://static.mocortech.com/production/mxc-web-ucenter-v4/97/_next/static/chunks/0mi~cl83iearu.js\\\",\\\"async\\\":true}]],\\\"template\\\":[\\\"$\\\",\\\"$L3\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]}]}]\\n24:null\\n\"])\u003C/script>\u003Cscript>self.__next_f.push([1,\"29:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"The World's No. 1 Crypto Exchange in Token Selections, Fees, and More | Sign Up Today | MEXC\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Sign up on MEXC to experience a world class exchange. Trade top trending tokens such as BTC, ETH, and more with the lowest fees. Explore amazing benefits and airdrops. MEXC - Your 0-fee gateway to infinite opportunities.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"2\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"MEXC Exchange sign up\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"X-UA-Compatible\\