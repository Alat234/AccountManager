nt_2\\\":\\\"Long-term investments\\\",\\\"mc_user_id_auth_due_diligence_use_your_trading_account_3\\\":\\\"Speculation\\\",\\\"mc_user_id_auth_due_diligence_use_your_trading_account_4\\\":\\\"Frequent trading\\\",\\\"mc_user_id_auth_due_diligence_use_your_trading_account_5\\\":\\\"Remittance payments\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume\\\":\\\"Expected Monthly Trading Volume (USD)\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_1\\\":\\\"Below 500 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_2\\\":\\\"500 – 1,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_3\\\":\\\"1,000 – 2,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_4\\\":\\\"2,000 – 3,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_5\\\":\\\"3,000 – 4,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_6\\\":\\\"4,000 – 5,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_7\\\":\\\"5,000 – 10,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_8\\\":\\\"10,000 – 20,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_9\\\":\\\"20,000 – 50,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_10\\\":\\\"50,000 – 100,000 USD\\\",\\\"mc_user_id_auth_due_diligence_expected_monthly_trading_volume_11\\\":\\\"Over 100,000 USD\\\",\\\"mc_user_hot_activity_title\\\":\\\"Hot Events\\\",\\\"mc_user_hot_activity_more\\\":\\\"Explore More Events\\\",\\\"mc_user_hot_activity_date\\\":\\\"End Date:\\\",\\\"mc_user_hot_activity_status\\\":\\\"Ongoing\\\",\\\"mc_user_id_auth_due_diligence_info_with_colon\\\":\\\"Due Diligence: \\\",\\\"mc_user_id_open_api_clear_trading_pairs_tips\\\":\\\"Clicking Confirm will clear the expired trading pairs\\\",\\\"mc_user_id_open_expired_trading_pairs\\\":\\\"Expired Trading Pairs\\\",\\\"mc_user_user_download_title\\\":\\\"Download MEXC App\\\",\\\"mc_user_user_download_info\\\":\\\"Your 0-Fee Gateway to Infinite Opportunities\\\",\\\"mc_sub_account_create_subaccount_risk_review\\\":\\\"Account Risk Review\\\",\\\"mc_sub_account_create_subaccount_risk_for_create\\\":\\\"Sub-account creation is temporarily unavailable for this account. Please click [Proceed to Review] and follow the instructions to complete the account risk review. You can view the progress and results at any time.\\\",\\\"mc_sub_account_create_subaccount_risk_proceed_to_review\\\":\\\"Proceed to Review\\\",\\\"mc_sub_account_create_subaccount_risk_for_transfer\\\":\\\"Asset transfers are temporarily unavailable for this account. Please click [Proceed to Review] and follow the instructions to complete the account risk review. You can view the progress and results at any time.\\\",\\\"mc_sub_account_create_subaccount_remark_limit_placeholder\\\":\\\"Please enter a note (up to {num} characters)\\\",\\\"mc_user_id_auth_address_proof_info_3\\\":\\\"Please provide proof of your current residential address \\u003cspan\\u003eissued within 3 months ({start} to {end})\\u003c/span\\u003e.\\\",\\\"mc_user_id_auth_address_proof_radio_title\\\":\\\"Address Verification Document Types\\\",\\\"mc_user_id_auth_address_proof_radio_1\\\":\\\"Documentary evidence\\\",\\\"mc_user_id_auth_address_proof_radio_2\\\":\\\"ID with address (front and back)\\\",\\\"mc_user_id_auth_address_proof_file_note\\\":\\\"Please ensure the uploaded document clearly shows your full address details and name so we can accurately verify your information.\\\",\\\"mc_user_id_auth_address_proof_file_click_front\\\":\\\"Click to upload the front side\\\",\\\"mc_user_id_auth_address_proof_file_click_back\\\":\\\"Click to upload the back side\\\",\\\"mc_user_id_auth_address_proof_file_requirement_4\\\":\\\"The issuance date of the document must be within 3 months ({start} to {end}).\\\",\\\"mc_sub_assets_hide_zero\\\":\\\"Hide 0 balance assets\\\",\\\"mc_user_id_auth_additional_faq_qustion_1\\\":\\\"Why is address verification required?\\\",\\\"mc_user_id_auth_additional_faq_qustion_3\\\":\\\"What types of documents are accepted as proof of address?\\\",\\\"mc_user_id_auth_additional_faq_qustion_4\\\":\\\"What are the requirements for address verification?\\\",\\\"mc_user_id_auth_additional_faq_answer_1\\\":\\\"Address verification is part of MEXC's KYC verification process to confirm your residential address. During address verification, you are required to provide your full name, address, and the necessary documents.\\\",\\\"mc_user_id_auth_additional_faq_answer_3_1\\\":\\\"Accepted documents include:\\\",\\\"mc_user_id_auth_additional_faq_answer_3_2\\\":\\\"1. Proof of Address Documents\\\",\\\"mc_user_id_auth_additional_faq_answer_4\\\":\\\"The document must include your full name, clearly state your residence address, issuance date, and the issuer's name. The issuance date must be within the last 3 months from the submission date.\\\",\\\"mc_user_preference_telegram_notice\\\":\\\"Telegram Notifications\\\",\\\"mc_user_preference_order_notifications\\\":\\\"P2P Orders\\\",\\\"mc_user_preference_appeal_notifications\\\":\\\"P2P Appeals\\\",\\\"mc_user_preference_other_notifications\\\":\\\"P2P Other\\\",\\\"mc_user_preference_p2p\\\":\\\"P2P\\\",\\\"mc_user_id_auth_additional_requirement_info_edited\\\":\\\"Edited\\\",\\\"mc_user_id_auth_additional_requirement_info_screenshot\\\":\\\"Screenshot\\\",\\\"mc_user_id_auth_address_reject_title\\\":\\\"Reason for Previous Rejection\\\",\\\"mc_user_id_auth_address_id_card_file_requirement_1\\\":\\\"Document must include your full address details and name.\\\",\\\"mc_user_id_auth_address_id_card_file_requirement_2\\\":\\\"Please ensure you upload both the front and back of the document, or the page that contains your full address details.\\\",\\\"mc_user_id_auth_address_id_card_file_requirement_3\\\":\\\"Please ensure your document is within its validity period and not expired.\\\",\\\"mc_user_id_auth_address_id_card_file_requirement_4\\\":\\\"The name on the document must match the name of the account holder.\\\",\\\"mc_user_id_auth_address_proof_file_requirement_5\\\":\\\"ID cards, passports, driver’s licenses, and residence permits are currently not accepted as valid address verification documents.\\\",\\\"mc_user_id_auth_address_proof_file_not_support_file4_new1\\\":\\\"Unsupported file type: ID card/Passport/Driver's License/Residence Permit\\\",\\\"mc_user_id_auth_address_proof_file_not_support_file4_new2\\\":\\\"Unsupported file type: Screenshot/Receipt/Medical Bill\\\",\\\"mc_auth_login_og_title\\\":\\\"Safe and Secure Access to Your Crypto Trading Account | MEXC - Your 0-Fee Gateway to Infinite Opportunities\\\",\\\"mc_auth_login_og_description\\\":\\\"Log in to trade with the lowest fees, access the most trending tokens, and enjoy everyday airdrops. Stay connected to crypto anytime and anywhere with MEXC. We are your 0-fee gateway to infinite opportunities.\\\",\\\"mc_auth_login_og_image_alt\\\":\\\"Secure Login, Secure Trading\\\",\\\"mc_auth_login_twitter_title\\\":\\\"Safe and Secure Access to Your Crypto Trading Account | MEXC - Your 0-Fee Gateway to Infinite Opportunities\\\",\\\"mc_auth_login_twitter_description\\\":\\\"Log in to trade with the lowest fees, access the most trending tokens, and enjoy everyday airdrops. Stay connected to crypto anytime and anywhere with MEXC. We are your 0-fee gateway to infinite opportunities.\\\",\\\"mc_auth_register_og_title\\\":\\\"Sign Up Today | Experience Lowest Fees, Trending Tokens, and More | MEXC - Your 0-Fee Gateway to Infinite Opportunities\\\",\\\"mc_auth_register_og_description\\\":\\\"Sign up to trade with the lowest fees, access the most trending tokens, and enjoy everyday airdrops. Stay connected to crypto anytime and anywhere with MEXC. We are your 0-fee gateway to infinite opportunities.\\\",\\\"mc_auth_register_og_image_alt\\\":\\\"MEXC - Your 0-Fee Gateway to Infinite Opportunities\\\",\\\"mc_auth_register_twitter_title\\\":\\\"Sign Up Today | Experience Lowest Fees, Trending Tokens, and More | MEXC - Your 0-Fee Gateway to Infinite Opportunities\\\",\\\"mc_auth_register_twitter_description\\\":\\\"Sign up to trade with the lowest fees, access the most trending tokens, and enjoy everyday airdrops. Stay connected to crypto anytime and anywhere with MEXC. We are your 0-fee gateway to infinite opportunities.\\\",\\\"mc_common_login_privacy_and_dex_agreed\\\":\\\"By proceeding, you agree to the \\u003ca\\u003eMEXC User Agreement\\u003c/a\\u003e, \\u003cb\\u003eDEX+ User Agreement\\u003c/b\\u003e, and \\u003cc\\u003ePrivacy Policy\\u003c/c\\u003e.\\\",\\\"mc_common_login_privacy_and_dex_agreed_info\\\":\\\"Your MEXC Exchange account \\u0026 DEX+ account will be activated\\\",\\\"mc_user_id_auth_advanced_verification_step_1_info_SH\\\":\\\"Please provide a valid photo of your identification document (ID card or passport). Ensure the document is not expired or damaged.\\\",\\\"mc_user_id_auth_advanced_photo_requirement_info_0_SH\\\":\\\"The following types of identification are accepted: ✅ ID card ✅ Passport\\\",\\\"mc_vip_vip_plan\\\":\\\"VIP Program\\\",\\\"mc_vip_vip_level\\\":\\\"VIP Level\\\",\\\"mc_vip_trad_volume_require\\\":\\\"Trading Volume Requirement (USDT)\\\",\\\"mc_vip_vip_faq\\\":\\\"FAQ\\\",\\\"mc_vip_become_vip_ask\\\":\\\"What are the benefits of becoming a MEXC VIP?\\\",\\\"mc_vip_become_vip_answer\\\":\\\"As a MEXC VIP, you will enjoy a range of exclusive benefits, including: a dedicated VIP support channel, dedicated account manager, VIP prize pools for M-Day events, exclusive market alerts, VIP-only events, official merch, and additional perks.\\\",\\\"mc_vip_update_vip_level_ask\\\":\\\"When will my VIP level be updated?\\\",\\\"mc_vip_update_vip_level_answer\\\":\\\"Your VIP level will be updated the next day. Once the trading volume meets the requirement, your level will be upgraded automatically.\\u003cbr\\u003e\\u003c/br\\u003eAt 16:00 (UTC) on the last day of each month, the system will reassess your trading volume. Users who do not meet the requirements will be automatically downgraded.\\\",\\\"mc_vip_included_trad_types_ask\\\":\\\"Which types of trades are included in the VIP level trading volume calculation?\\\",\\\"mc_vip_included_trad_types_answer\\\":\\\"The VIP level trading volume includes Spot trading, Futures trading, API trading, and DEX+ trading volume. It does not include 0-fee trading volume or trades made through sub-accounts.\\\",\\\"mc_vip_receive_vip_merchandise_ask\\\":\\\"How can I receive VIP-exclusive merchandise?\\\",\\\"mc_vip_receive_vip_merchandise_answer\\\":\\\"You can contact your dedicated account manager to receive your VIP welcome gift upon first becoming a VIP, as well as exclusive merchandise for VIP upgrades or seasonal events.\\\",\\\"mc_vip_need_handle_ask\\\":\\\"Does the VIP Program require manual application?\\\",\\\"mc_vip_need_handle_answer\\\":\\\"No, the VIP level is automatically adjusted based on your trading volume. No manual application is required.\\\",\\\"mc_vip_can_multiple_accounts_ask\\\":\\\"Can I increase my VIP level by using multiple accounts?\\\",\\\"mc_vip_can_multiple_accounts_answer\\\":\\\"No\\\",\\\"mc_vip_terms_and_conditions\\\":\\\"Terms and Conditions\\\",\\\"mc_vip_terms_and_conditions_list\\\":\\\"1. Affiliates, institutional users, and referred users are not eligible to participate in the VIP program.\\u003cbr\\u003e\\u003c/br\\u003e2. Trading volume counted toward VIP status includes Spot trading, Futures trading, API trading, and DEX+ trading volume. Trades with zero fees and trades made through sub-accounts are excluded from the VIP trading volume calculation.\\u003cbr\\u003e\\u003c/br\\u003e3. Trading volume is calculated on a calendar month basis.\\u003cbr\\u003e\\u003c/br\\u003e4. Accounts that trigger platform risk control measures may have their VIP status temporarily suspended. MEXC reserves the right to disqualify participants.\\u003cbr\\u003e\\u003c/br\\u003e5. All users must comply with MEXC's Terms of Service. MEXC reserves the right of final interpretation for this event. For any inquiries, please contact Customer Service.\\\",\\\"mc_vip_online_support\\\":\\\"Priority Online Customer Service\\\",\\\"mc_vip_1_by_1_telegram_manager\\\":\\\"Dedicated Telegram Account Manager\\\",\\\"mc_vip_m_day_prize_pool\\\":\\\"Exclusive M-Day Prize Pool\\\",\\\"mc_vip_exclusive_market_alerts\\\":\\\"Exclusive Market Alerts\\\",\\\"mc_vip_exclusive_events\\\":\\\"Exclusive Events\\\",\\\"mc_vip_exclusive_official_mech\\\":\\\"Official Merch\\\",\\\"mc_vip_exclusive_benefits\\\":\\\"Exclusive Benefits\\\",\\\"mc_common_update_time\\\":\\\"Update Time\\\",\\\"mc_common_add_time\\\":\\\"Date Added\\\",\\\"mc_common_edit\\\":\\\"Edit\\\",\\\"mc_user_sub_account_strategy_group_management\\\":\\\"Strategy Group Management\\\",\\\"mc_user_sub_account_strategy_group_list\\\":\\\"Strategy Group List ({number1}/{number2})\\\",\\\"mc_user_sub_account_create_new_strategy_group\\\":\\\"Create New Strategy Group\\\",\\\"mc_user_sub_account_strategy_group_id\\\":\\\"Strategy Group ID\\\",\\\"mc_user_sub_account_strategy_group_name\\\":\\\"Strategy Group Name\\\",\\\"mc_user_sub_account_accounts_included_in_strategy_group\\\":\\\"Accounts Included in Strategy Group\\\",\\\"mc_user_sub_account_delete_account\\\":\\\"Remove Account\\\",\\\"mc_user_sub_account_delete_strategy_group\\\":\\\"Delete Strategy Group\\\",\\\"mc_user_sub_account_delete_strategy_group_confirm\\\":\\\"Are you sure you want to delete this strategy group?\\\",\\\"mc_user_sub_account_edit_strategy_group\\\":\\\"Edit Strategy Group\\\",\\\"mc_user_sub_account_edit_strategy_group_hint\\\":\\\"Note: When editing accounts within a strategy group, the new group settings will only apply to new orders. Existing or pending orders will follow the original settings.\\\",\\\"mc_user_sub_account_delete_strategy_group_account\\\":\\\"Remove Account from Strategy Group\\\",\\\"mc_user_sub_account_delete_strategy_group_account_confirm\\\":\\\"Are you sure you want to remove this account? The account will no longer be part of the strategy group's STP.\\\",\\\"mc_user_sub_account_create_new_strategy_group_hint\\\":\\\"Note: When sub-accounts under the same main account are assigned to the same strategy group, and an order is placed via API with Self-Trade Prevention (STP) enabled, the system will enforce self-trade blocking among accounts within the same group based on the configured settings.\\\",\\\"mc_user_sub_account_accounts_included_in_strategy_group_hint\\\":\\\"Please enter UIDs, up to 50, separated by commas (,).\\\",\\\"mc_common_message_second_new_convert_listings\\\":\\\"New Convert Listings\\\",\\\"mc_user_security_passkey_no_password_desc\\\":\\\"With a passkey, you can use your fingerprint or facial recognition instead of a password\\\",\\\"mc_user_security_passkey_cross_device\\\":\\\"Works across all your devices\\\",\\\"mc_user_security_passkey_cross_device_desc\\\":\\\"Supports cross-device use, including Windows, Mac, and mobile devices\\\",\\\"mc_user_security_passkey_secure_account\\\":\\\"Keep your account secure\\\",\\\"mc_user_security_passkey_secure_account_desc\\\":\\\"Protects against phishing and other online threats to enhance your account’s security\\\",\\\"mc_user_security_passkey_what_is\\\":\\\"What is a Passkey?\\\",\\\"mc_user_security_passkey_add\\\":\\\"Add Passkey\\\",\\\"mc_user_security_passkey_have_created\\\":\\\"You have created {count} passkeys (up to 10 allowed).\\\",\\\"mc_user_security_passkey_name\\\":\\\"Passkey Name\\\",\\\"mc_user_security_passkey_created_on\\\":\\\"Created On\\\",\\\"mc_user_security_passkey_last_used\\\":\\\"Last Used\\\",\\\"mc_user_security_passkey_btn_rename\\\":\\\"Rename\\\",\\\"mc_user_security_passkey_btn_delete\\\":\\\"Delete\\\",\\\"mc_user_security_passkey_actions\\\":\\\"Actions\\\",\\\"mc_user_security_passkey_cross_device_tag\\\":\\\"Cross-Device\\\",\\\"mc_user_security_passkey_rename\\\":\\\"Rename Passkey\\\",\\\"mc_user_security_passkey_confirm\\\":\\\"Confirm\\\",\\\"mc_user_security_passkey_delete_title\\\":\\\"Are you sure you want to delete this passkey?\\\",\\\"mc_user_security_passkey_delete_desc\\\":\\\"For your account’s security, deleting a passkey may temporarily disable on-chain withdrawals, internal transfers, fiat withdrawals, and P2P trading for up to 24 hours, depending on your risk control status. Passkeys offer enhanced protection for your account and assets. We recommend keeping them enabled.\\\",\\\"mc_user_security_passkey_delete_cancel\\\":\\\"Cancel\\\",\\\"mc_user_security_passkey_delete_success\\\":\\\"Successfully Deleted\\\",\\\"mc_user_security_passkey_delete_success_desc\\\":\\\"Your passkey {passkey_name} has been deleted\\\",\\\"mc_user_security_passkey_delete_success_ok\\\":\\\"Got it\\\",\\\"mc_user_security_new_passkey\\\":\\\"Passkey\\\",\\\"mc_user_security_new_passkey_desc\\\":\\\"Add a passkey for faster and safer account protection\\\",\\\"mc_user_security_passkey_no_password_login\\\":\\\"Log in without a password\\\",\\\"mc_user_security_unlink_google_authenticator_title\\\":\\\"Are you sure you want to unlink Google Authenticator?\\\",\\\"mc_user_security_unlink_google_authenticator_desc\\\":\\\"To ensure the security of your assets, \\u003chighlight\\u003ewithdrawals and fiat withdrawals will be disabled for 24 hours\\u003c/highlight\\u003e after removing Google Authenticator.\\\",\\\"mc_user_security_unlink_google_authenticator_confirm\\\":\\\"Withdrawals and related actions require two-factor authentication. Using only one method may expose your account to higher risk.\\\",\\\"mc_user_security_unlink_google_authenticator_btn_confirm\\\":\\\"Unlink Anyway\\\",\\\"mc_user_security_change_email_confirm\\\":\\\"Are you sure you want to change your email address: {email}?\\\",\\\"mc_user_security_change_email_24_hour_limit\\\":\\\"To ensure the security of your assets, \\u003cspan\\u003ewithdrawals and fiat withdrawals will be disabled for 24 hours\\u003c/span\\u003e after changing your email.\\\",\\\"mc_user_security_change_mobile_confirm\\\":\\\"Are you sure you want to change your mobile number: {countryCode} {phoneNumber}?\\\",\\\"mc_user_security_change_mobile_24_hour_limit\\\":\\\"To ensure the security of your assets, \\u003cspan\\u003ewithdrawals and fiat withdrawals will be disabled for 24 hours\\u003c/span\\u003e after changing your mobile number.\\\",\\\"mc_user_security_confirm_change\\\":\\\"Change Anyway\\\",\\\"mc_user_security_change_binding\\\":\\\"Change Anyway\\\",\\\"mc_user_security_improve_account_security\\\":\\\"Enhance Account Security\\\",\\\"mc_user_security_link_email\\\":\\\"Add Email\\\",\\\"mc_user_security_link_email_protection_account\\\":\\\"Linking your email helps secure your account with stronger protection.\\\",\\\"mc_user_security_link_mobile\\\":\\\"Add Phone Number\\\",\\\"mc_user_security_link_mobile_protection_account\\\":\\\"Linking your phone number helps secure your account with stronger protection.\\\",\\\"mc_user_security_passkey_not_available\\\":\\\"Not Available on This Device\\\",\\\"mc_common_message_platform_benefits\\\":\\\"Platform Rewards\\\",\\\"mc_merkle_reserve_proof_title\\\":\\\"Proof of Reserves\\\",\\\"mc_merkle_reserve_proof_desc\\\":\\\"MEXC maintains a 1:1 reserve of all user assets, ensuring security and transparency\\\",\\\"mc_merkle_reserve_proof_my_prove\\\":\\\"My Proof of Reserves\\\",\\\"mc_merkle_reserve_proof_ratio_title\\\":\\\"MEXC Reserve Rate\\\",\\\"mc_merkle_reserve_proof_ratio_desc\\\":\\\"Reserve Rate = MEXC Wallet Assets / Total User Assets on MEXC. A rate of 100% or higher means the platform holds sufficient funds to back all user assets\\\",\\\"mc_merkle_reserve_proof_ratio_coin\\\":\\\"{coin} Reserve Rate\\\",\\\"mc_merkle_reserve_proof_ratio_total_asset\\\":\\\"MEXC Reserves\\\",\\\"mc_merkle_reserve_proof_ratio_user_asset\\\":\\\"Total User Assets on MEXC\\\",\\\"mc_merkle_reserve_proof_ratio_snapshot\\\":\\\"Snapshot on:\\\",\\\"mc_merkle_reserve_proof_scope_title\\\":\\\"Audit Scope\\\",\\\"mc_merkle_reserve_proof_scope_desc\\\":\\\"MEXC provides verified token, network, and wallet address data. All information is fully transparent and accessible.\\\",\\\"mc_merkle_reserve_proof_scope_asset\\\":\\\"Asset\\\",\\\"mc_merkle_reserve_proof_scope_network\\\":\\\"Network\\\",\\\"mc_merkle_reserve_proof_scope_address\\\":\\\"Wallet Address\\\",\\\"mc_merkle_reserve_proof_scope_balance\\\":\\\"Balance\\\",\\\"mc_merkle_reserve_proof_scope_download\\\":\\\"Download All\\\",\\\"mc_merkle_reserve_proof_what_title\\\":\\\"What Is Proof of Reserves?\\\",\\\"mc_merkle_reserve_proof_matter_title\\\":\\\"Why Proof of Reserves Matters\\\",\\\"mc_merkle_reserve_proof_worse_title\\\":\\\"Without 1:1 Reserves\\\",\\\"mc_merkle_reserve_proof_worse_desc1\\\":\\\"Assets vulnerable to misappropriation\\\",\\\"mc_merkle_reserve_proof_worse_desc2\\\":\\\"Withdrawal delays, rejections, and risks of bank runs\\\",\\\"mc_merkle_reserve_proof_worse_desc3\\\":\\\"Risk of bankruptcy and total asset loss\\\",\\\"mc_merkle_reserve_proof_better_title\\\":\\\"Reserves Backed 1:1 and Beyond\\\",\\\"mc_merkle_reserve_proof_better_desc1\\\":\\\"Assets are completely secure and transparent\\\",\\\"mc_merkle_reserve_proof_better_desc2\\\":\\\"Assets are accessible at all times\\\",\\\"mc_merkle_reserve_proof_better_desc3\\\":\\\"Risk of bankruptcy eliminated\\\",\\\"mc_merkle_reserve_proof_audit_id\\\":\\\"Audit ID\\\",\\\"mc_merkle_reserve_proof_date\\\":\\\"Date\\\",\\\"mc_merkle_reserve_proof_type\\\":\\\"Type\\\",\\\"mc_merkle_reserve_proof_merkle_hash\\\":\\\"Merkle Hash\\\",\\\"mc_merkle_reserve_proof_account\\\":\\\"Account\\\",\\\"mc_merkle_reserve_proof_account_total\\\":\\\"Total\\\",\\\"mc_merkle_reserve_proof_notes\\\":\\\"Notes\\\",\\\"mc_merkle_reserve_proof_notes_text1\\\":\\\"Report data reflects assets at a specific point in time and may differ from your current asset holdings. Discrepancies with your asset overview can occur if you held Futures positions when the snapshot was taken.\\\",\\\"mc_merkle_reserve_proof_self_verify\\\":\\\"How to perform self-verification?\\\",\\\"mc_merkle_reserve_proof_self_verify_text\\\":\\\"Learn how to verify your assets are included as a Merkle leaf\\\",\\\"mc_merkle_reserve_proof_download\\\":\\\"Download Data\\\",\\\"mc_merkle_reserve_proof_verify\\\":\\\"Verify Now\\\",\\\"mc_merkle_reserve_proof_verify_fail\\\":\\\"Verification failed. Please try again later.\\\",\\\"mc_merkle_reserve_proof_data_updating\\\":\\\"Updating data. Please try again tomorrow.\\\",\\\"mc_merkle_reserve_proof_my_path\\\":\\\"My Merkle Path\\\",\\\"mc_merkle_reserve_proof_branch\\\":\\\"Merkle branches\\\",\\\"mc_merkle_reserve_proof_verify_success\\\":\\\"Verified successfully\\\",\\\"mc_merkle_reserve_proof_my_hash\\\":\\\"My Hash\\\",\\\"mc_merkle_reserve_proof_my_position\\\":\\\"My Position\\\",\\\"mc_merkle_reserve_proof_hash\\\":\\\"Hash\\\",\\\"mc_merkle_reserve_proof_what_content\\\":\\\"In the cryptocurrency space, Proof of Reserves (PoR) is a transparency mechanism used to demonstrate that a crypto exchange or custodial platform holds sufficient reserve assets to fully back its users' deposits. The primary goal of PoR is to address trust issues by ensuring that customer assets stored on the platform are secure, and that the platform is not misusing funds or engaging in opaque financial practices.\\\",\\\"mc_merkle_reserve_proof_tdk_title\\\":\\\"MEXC Proof of Reserves: Transparent Crypto Holdings \\u0026 Asset Security | MEXC\\\",\\\"mc_merkle_reserve_proof_tdk_description\\\":\\\"Learn about MEXC's Proof of Reserves Utmost transparency and trust ensuring 100% asset security. Verify reserve rates and explore how MEXC safeguards your funds with full accountability. Start trading with con